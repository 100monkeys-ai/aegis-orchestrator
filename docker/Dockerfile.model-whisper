#
# The speech-to-text model image: the image a workflow's model step runs when
# it names image "model:speech-to-text/whisper-base", which the runtime
# registry's spec.models resolves to this image by tag and digest. The same
# file builds the speaker-turn image for "model:speech-to-text/whisper-small-en-tdrz"
# with other build arguments (below).
#
# It carries one engine and one model's weights, and runs on the CPU only:
#   - whisper.cpp (MIT), the C++ port of whisper, built from its release
#     source, checked by sha256, for any x86-64 CPU with AVX2 and FMA (no
#     tuning to the build machine's CPU, no GPU backend);
#   - the whisper base model (MIT; multilingual, 74M parameters), as
#     whisper.cpp's ggml-base.bin, checked by sha256 and baked in, so a step
#     fetches nothing and runs with no network;
#   - ffmpeg (Debian's), to decode the common audio containers.
# whisper.cpp rather than the reference Python package: one static binary
# with no Python, no PyTorch and no download at run time, a much smaller image,
# and faster on a CPU. base rather than tiny or small: tiny's errors are
# frequent on ordinary speech, and small runs about three times slower than
# base on a CPU, past what a step should take for a recording of minutes.
#
# The model is chosen by build arguments: WHISPER_MODEL names it,
# WHISPER_MODEL_SHA256 checks its weights and WHISPER_MODEL_URL is where they
# are fetched (by default whisper.cpp's own model repository). The defaults
# build the base model. The speaker-turn image is built with
#   WHISPER_MODEL=small.en-tdrz
#   WHISPER_MODEL_SHA256=ceac3ec06d1d98ef71aec665283564631055fd6129b79d8e1be4f9cc33cc54b4
#   WHISPER_MODEL_URL=https://huggingface.co/akashmjn/tinydiarize-whisper.cpp/resolve/d44ba793fc67e509623a88a409723311fa677744/ggml-small.en-tdrz.bin
# whisper.cpp's tinydiarize model (MIT; English only), which marks the end of
# each speaker's turn; its weights are not in whisper.cpp's model repository.
# The image records its model's name at /opt/whisper/model.
#
# The program is transcribe:
#   transcribe <audio file> --out <transcript path>
# It decodes the file to 16 kHz mono, transcribes it with sampling fixed
# (temperature 0, no temperature fallback) so the same file gives the same
# text, writes the transcript as UTF-8 text to the path, and prints it on
# stdout. On failure it exits non-zero with one sentence on stderr.
# For a model whose name ends in -tdrz it transcribes in English with
# timestamps on and speaker turns marked (-tdrz), and renders whisper-cli's
# segments with /usr/local/share/transcribe/turns.awk: a new paragraph at each
# change of speaker, labelled "Speaker 1:" and "Speaker 2:" in turn, with the
# timestamps removed. (With --no-timestamps whisper decodes each 30-second
# window as one segment, so a turn would land on window ends; and the
# --output-txt file carries no turn marker.) Every other model runs as base
# does.
#
# Published by pipeline.yml as ghcr.io/100monkeys-ai/aegis-model-whisper,
# tagged whisper-cpp-<WHISPER_CPP_VERSION>-<WHISPER_MODEL> (and the default
# build also sha-<commit>). A change of either changes that tag and the
# registry entry that names it.
#
# Build (from the directory holding aegis-orchestrator, as CI does; the image
# needs nothing from the context):
#   podman build -f aegis-orchestrator/docker/Dockerfile.model-whisper .

ARG BASE_IMAGE=docker.io/library/debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587

FROM ${BASE_IMAGE} AS build
ARG WHISPER_CPP_VERSION=1.9.4
ARG WHISPER_CPP_SHA256=57e280cee375ab02425b806ad5146b99f6eb9357e3c2b31357c8a6af2e2e44ae
ARG WHISPER_MODEL=base
ARG WHISPER_MODEL_SHA256=60ed5bc3dd14eea856493d334349b405782ddcaf0028d4b5df4088345fba2efe
ARG WHISPER_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-${WHISPER_MODEL}.bin
ADD https://github.com/ggml-org/whisper.cpp/archive/refs/tags/v${WHISPER_CPP_VERSION}.tar.gz /tmp/whisper-cpp.tar.gz
ADD ${WHISPER_MODEL_URL} /tmp/ggml-model.bin
RUN echo "${WHISPER_CPP_SHA256}  /tmp/whisper-cpp.tar.gz" | sha256sum -c - \
    && echo "${WHISPER_MODEL_SHA256}  /tmp/ggml-model.bin" | sha256sum -c -
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential cmake \
    && rm -rf /var/lib/apt/lists/*
# The archive is unpacked with no owner or mode taken from it, so nothing
# changes an owner or a directory's mode (the CI runner's build refuses that).
RUN mkdir /src \
    && tar --no-same-owner --no-same-permissions -xzf /tmp/whisper-cpp.tar.gz -C /src \
    && cmake -S /src/whisper.cpp-${WHISPER_CPP_VERSION} -B /src/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=OFF \
        -DWHISPER_BUILD_TESTS=OFF \
        -DWHISPER_BUILD_SERVER=OFF \
        -DGGML_NATIVE=OFF \
        -DGGML_AVX=ON -DGGML_AVX2=ON -DGGML_FMA=ON -DGGML_F16C=ON \
        -DGGML_AVX512=OFF \
        -DGGML_OPENMP=OFF \
    && cmake --build /src/build --config Release --target whisper-cli -j "$(nproc)" \
    && mkdir /out \
    && cp /src/build/bin/whisper-cli /out/whisper-cli \
    && cp /tmp/ggml-model.bin /out/ggml-model.bin \
    && printf '%s\n' "${WHISPER_MODEL}" > /out/model

FROM ${BASE_IMAGE}
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/whisper-cli /usr/local/bin/whisper-cli
COPY --from=build /out/ggml-model.bin /opt/whisper/ggml-model.bin
COPY --from=build /out/model /opt/whisper/model
# turns.awk renders whisper-cli -tdrz standard output (timestamps on) as
# speaker turns. Each segment line is "[hh:mm:ss.mmm --> hh:mm:ss.mmm]  text",
# ending in " [SPEAKER_TURN]" when the speaker changes after it; any other line
# is not a segment and is skipped. A paragraph joins segment texts with one
# space until a segment ends a turn; paragraphs are labelled Speaker 1 and
# Speaker 2 alternately, from Speaker 1, and separated by one blank line; the
# last paragraph closes at the end, marker or not. POSIX awk (mawk here).
RUN mkdir -p /usr/local/share/transcribe \
    && printf '%s\n' \
    'function emit() {' \
    '    if (para == "") return' \
    '    printf "%sSpeaker %d: %s\n", (n > 0 ? "\n" : ""), (n % 2) + 1, para' \
    '    n++' \
    '    para = ""' \
    '}' \
    '/^\[[0-9:.]+ --> [0-9:.]+\]/ {' \
    '    sub(/^\[[0-9:.]+ --> [0-9:.]+\][ \t]*/, "")' \
    '    turn = sub(/[ \t]*\[SPEAKER_TURN\][ \t]*$/, "")' \
    '    sub(/^[ \t]+/, "")' \
    '    sub(/[ \t]+$/, "")' \
    '    if ($0 != "") para = (para == "" ? $0 : para " " $0)' \
    '    if (turn) emit()' \
    '}' \
    'END { emit() }' \
    > /usr/local/share/transcribe/turns.awk \
    && printf '%s\n' \
    '#!/bin/sh' \
    '# transcribe <audio file> --out <transcript path>' \
    'set -u' \
    'if [ "$#" -ne 3 ] || [ "$2" != "--out" ]; then echo "usage: transcribe <audio file> --out <transcript path>" >&2; exit 2; fi' \
    'in=$1' \
    'out=$3' \
    'if [ ! -f "$in" ]; then echo "transcribe: there is no audio file at $in" >&2; exit 1; fi' \
    'work=$(mktemp -d) || { echo "transcribe: no working directory could be made" >&2; exit 1; }' \
    'trap "rm -rf \"$work\"" EXIT' \
    'if ! ffmpeg -nostdin -hide_banner -loglevel error -i "$in" -vn -ar 16000 -ac 1 -c:a pcm_s16le "$work/audio.wav"; then echo "transcribe: $in could not be decoded as audio" >&2; exit 1; fi' \
    'model=$(cat /opt/whisper/model) || { echo "transcribe: the image names no model" >&2; exit 1; }' \
    'case "$model" in' \
    '*-tdrz)' \
    'if ! whisper-cli --model /opt/whisper/ggml-model.bin --file "$work/audio.wav" --language en --temperature 0 --no-fallback --no-prints -tdrz --output-txt --output-file "$work/transcript" > "$work/segments.txt" 2> "$work/whisper.log"; then echo "transcribe: the model could not transcribe $in" >&2; exit 1; fi' \
    'if ! mkdir -p "$(dirname "$out")" || ! awk -f /usr/local/share/transcribe/turns.awk "$work/segments.txt" > "$out"; then echo "transcribe: the transcript could not be written to $out" >&2; exit 1; fi' \
    ';;' \
    '*)' \
    'if ! whisper-cli --model /opt/whisper/ggml-model.bin --file "$work/audio.wav" --language auto --temperature 0 --no-fallback --no-timestamps --no-prints --output-txt --output-file "$work/transcript" > "$work/whisper.log" 2>&1; then echo "transcribe: the model could not transcribe $in" >&2; exit 1; fi' \
    'if ! mkdir -p "$(dirname "$out")" || ! sed -e "s/^[[:space:]]*//" "$work/transcript.txt" > "$out"; then echo "transcribe: the transcript could not be written to $out" >&2; exit 1; fi' \
    ';;' \
    'esac' \
    'cat "$out"' \
    > /usr/local/bin/transcribe \
    && chmod 0755 /usr/local/bin/transcribe \
    && whisper-cli --help > /dev/null 2>&1 \
    && ffmpeg -hide_banner -version | head -n 1
